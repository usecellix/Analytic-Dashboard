# Required. The admin dashboard is locked until this is set.
ADMIN_PASSWORD=
# Optional extra secret mixed into session signing; rotate to sign everyone out.
ADMIN_SESSION_SECRET=

# Required. Base URL of cellix_backend (no trailing slash) — the Dashboard's
# data layer calls this instead of connecting to Mongo directly.
CELLIX_API_URL=http://localhost:4001
# Required. Must match cellix_backend's own CELLIX_ADMIN_API_TOKEN exactly —
# it's the shared secret AdminGuard checks on every /admin/* request.
CELLIX_ADMIN_API_TOKEN=
